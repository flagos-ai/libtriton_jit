ARG BASE_IMAGE=nvidia/cuda:12.6.0-devel-rockylinux9
FROM ${BASE_IMAGE} AS build-env

# Vendor flavor (nvidia|metax|mthreads) and matching CMake backend policy.
# Defaults keep the historical nvidia/CUDA build.
ARG VENDOR=nvidia
ARG BACKEND=CUDA
ARG PYTHON_INDEX=https://pypi.org/simple
ARG PYTHON_PACKAGES

COPY packaging/rpm/prepare-build-env.sh /tmp/prepare-build-env.sh
RUN bash /tmp/prepare-build-env.sh

FROM build-env AS builder

# NVIDIA's Fedora RPMs do not add nvcc to PATH, unlike the CUDA base images.
ENV PATH=/usr/local/cuda/bin:${PATH}

# Setup RPM build environment
RUN rpmdev-setuptree

WORKDIR /workspace
COPY . /workspace/

# Create source tarball
RUN tar czf /root/rpmbuild/SOURCES/libtriton-jit-0.1.0.tar.gz \
    --transform 's,^\.,libtriton-jit-0.1.0,' \
    --exclude='.git' \
    --exclude='build' \
    --exclude='build-*.log' \
    --exclude='debian-packages' \
    --exclude='rpm-packages' \
    .

# Build the RPM package (--nocheck to skip dep verification)
RUN rpmbuild -ba --nocheck \
    --define "vendor_flavor ${VENDOR}" \
    --define "backend ${BACKEND}" \
    /workspace/packaging/rpm/libtriton-jit.spec || \
    { echo "RPM build failed"; exit 1; }

# Collect built RPMs into /output
RUN mkdir -p /output/rpms /output/srpms && \
    find /root/rpmbuild/RPMS -name "*.rpm" -exec cp {} /output/rpms/ \; && \
    find /root/rpmbuild/SRPMS -name "*.rpm" -exec cp {} /output/srpms/ \; && \
    ls -lhR /output/

# Output stage
FROM alpine:latest AS output
COPY --from=builder /output/ /output/
