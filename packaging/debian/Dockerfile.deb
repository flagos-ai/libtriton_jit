# Multi-stage Dockerfile to build Debian packages for libtriton-jit.
#
# Builds strictly against the base Ubuntu release's native system Python
# (3.10 on Ubuntu 22.04, 3.12 on Ubuntu 24.04) with no external PPA, stamping
# +ubuntu<ver> onto the package revision so each suite carries an ABI-matched build.

ARG BASE_IMAGE=nvidia/cuda:12.8.0-devel-ubuntu24.04
FROM ${BASE_IMAGE} AS builder

ARG DEB_VERSION_SUFFIX=auto
ARG TORCH_INDEX=https://resource.flagos.net/repository/flagos-pypi-nvidia/simple
ARG TORCH_PACKAGES="torch==2.10.0+cu128 triton==3.6.0"
ARG BUILD_PARALLEL=4
ARG VENDOR=nvidia
ARG BACKEND=CUDA
ENV DEBIAN_FRONTEND=noninteractive
ENV PIP_BREAK_SYSTEM_PACKAGES=1

RUN apt-get update && apt-get install -y --no-install-recommends \
        ca-certificates curl build-essential cmake debhelper devscripts \
        dpkg-dev fakeroot git libfmt-dev ninja-build nlohmann-json3-dev \
        patchelf python3 python3-dev python3-pip python3-packaging \
        python3-venv \
    && . /etc/os-release \
    && pyver="$(python3 -c 'import sys; print(f"{sys.version_info.major}.{sys.version_info.minor}")')" \
    && case "${ID}:${VERSION_ID}:${pyver}" in \
        ubuntu:22.04:3.10|ubuntu:24.04:3.12) echo "Verified native Python ${pyver} for ${PRETTY_NAME}" ;; \
        *) echo "ERROR: ${ID} ${VERSION_ID} resolved Python ${pyver}; each suite must use its native distro Python" >&2; exit 1 ;; \
       esac \
    && apt-get clean && rm -rf /var/lib/apt/lists/*

# Ubuntu 22.04 ships cmake 3.22 (< 3.25 required); pip puts >=3.25 in /usr/local/bin.
# Fall back to PyTorch's cu128 wheel index and PyPI when the FlagOS index lacks
# a wheel for this Ubuntu release's Python minor (e.g. cp310 on 22.04).
RUN python3 -m pip install --no-cache-dir "cmake>=3.25,<4.0" "ninja==1.13.0" "pybind11==3.0.3" \
    && python3 -m pip install --no-cache-dir \
        --index-url "${TORCH_INDEX}" \
        --extra-index-url https://download.pytorch.org/whl/cu128 \
        --extra-index-url https://pypi.org/simple \
        ${TORCH_PACKAGES}

COPY . /workspace/libtriton-jit
WORKDIR /workspace/libtriton-jit

RUN cp -r packaging/debian debian && \
    bash debian/render-vendor.sh "${VENDOR}" debian && \
    if [ "${DEB_VERSION_SUFFIX}" = "auto" ]; then \
        . /etc/os-release && suffix="+${ID}${VERSION_ID}"; \
    else suffix="${DEB_VERSION_SUFFIX}"; fi && \
    if [ -n "${suffix}" ]; then \
        base="$(dpkg-parsechangelog -l debian/changelog -SVersion)" && \
        case "${base}" in *+ubuntu*) ;; *) \
            DEBFULLNAME="FlagOS Contributors" DEBEMAIL="contact@flagos.io" \
            dch -b -v "${base}${suffix}" -D unstable --force-distribution \
                "Rebuild for $(. /etc/os-release && echo "${PRETTY_NAME}")." ;; \
        esac && \
        echo "Package version: $(dpkg-parsechangelog -l debian/changelog -SVersion)"; \
    fi

RUN DEB_BUILD_OPTIONS="parallel=${BUILD_PARALLEL}" \
    DEB_TRITON_BACKEND="${BACKEND}" \
    dpkg-buildpackage -us -uc -b -d || \
    { echo "Build failed, checking logs..."; \
      find /workspace -name "*.log" -exec echo "=== {} ===" \; -exec cat {} \; 2>/dev/null || true; \
      exit 1; }

RUN mkdir -p /output && \
    find /workspace -maxdepth 1 -name "*.deb" -exec cp {} /output/ \; && \
    ls -lh /output/

FROM scratch AS output
COPY --from=builder /output/*.deb /output/
